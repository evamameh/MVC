Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{REQUEST_URI} ^/MVC/config(/|$) [NC]
RewriteRule .* - [F,L]

RewriteCond %{REQUEST_URI} ^/MVC/(app|core|routes|vendor)(/|$) [NC]
RewriteRule .* /MVC/public/index.php/login [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,L]
</IfModule>
